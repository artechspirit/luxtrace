# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Midtrans Configuration
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_ENV=sandbox

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Thirdweb Web3 Configuration
THIRDWEB_SECRET_KEY=your-thirdweb-secret-key
BRAND_WALLET_PRIVATE_KEY=0x_your_brand_wallet_private_key
BRAND_WALLET_ADDRESS=0x_your_brand_wallet_address
NFT_CONTRACT_ADDRESS=0x_your_deployed_erc721_contract_address

# Cryptographic Keys (NFC & QR Sessional Gates)
WALLET_MASTER_SEED=your-32-byte-hexadecimal-wallet-generator-seed
NFC_SECRET_SALT=your-random-nfc-salt-string
QR_ENCRYPTION_KEY=your-32-byte-hexadecimal-qr-encryption-key
