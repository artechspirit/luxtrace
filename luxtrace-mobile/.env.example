# Luxtrace Mobile Environment Variables
# Expo SDK 49+ uses EXPO_PUBLIC_ prefix to expose variables to the JS bundle.

# Base API URL pointing to the Next.js backend server.
# - Use 'http://localhost:3000/api' for local emulator testing.
# - Use your computer's local IP (e.g. 'http://192.168.1.50:3000/api') when testing on physical devices.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
